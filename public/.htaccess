# Regras do servidor da Hostinger (Apache/LiteSpeed). O Vite copia este arquivo de `public/` para a raiz do `dist/`.
# Tudo está dentro de <IfModule> para que um módulo ausente no plano não derrube o site com erro 500 (ADR-0039).

AddDefaultCharset UTF-8
Options -Indexes

# --- HTTPS e endereço único ---------------------------------------------------------------------------------------
# Sem o domínio escrito aqui: funciona em qualquer endereço. http -> https e www.isabellaeneto... -> isabellaeneto...
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Tipos de arquivo ---------------------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType audio/mpeg .mp3
  AddType font/woff2 .woff2
  AddType application/javascript .js
</IfModule>

# --- Compressão ---------------------------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Cache ---------------------------------------------------------------------------------------------------------
# O HTML (com o CSS dentro) e os arquivos de busca sempre revalidam: é por eles que uma versão nova chega.
# O JavaScript tem o hash do conteúdo no nome (`assets/index-<hash>.js`), então nunca muda sob o mesmo nome.
# Imagens, fotos, sons e fontes têm nome fixo: 7 dias, para uma troca de foto depois do envio não ficar presa.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|mp3|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Arquivos que não são do convite -------------------------------------------------------------------------------
# O estado do envio por FTP (`.ftp-deploy-sync-state.json`) e a cópia do CNAME do GitHub Pages não precisam ser públicos,
# e uma pasta `.git` (se o site for vinculado pelo Git do hPanel) jamais pode ser servida.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.ftp-deploy-sync-state\.json|CNAME)$">
    Require all denied
  </FilesMatch>
</IfModule>
