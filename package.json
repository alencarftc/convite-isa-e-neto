{
  "name": "convite-isa-e-neto",
  "version": "0.1.0",
  "private": true,
  "description": "Convite digital interativo do casamento de Isabella Vaz e David Neto.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.0"
  },
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 15.1",
    "ios_saf >= 15.1"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:rede": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:arch": "vitest run --project architecture",
    "test:coverage": "vitest run --coverage",
    "arch": "depcruise src scripts --config .dependency-cruiser.cjs",
    "arch:grafo": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid --output-to reports/arquitetura.mmd",
    "size": "size-limit",
    "verificar": "tsx scripts/verificar.ts",
    "fontes": "tsx scripts/copiar-fontes.ts",
    "arte:provisoria": "tsx scripts/gerar-arte-provisoria.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run lint:css && pnpm run typecheck && pnpm run arch && pnpm run test:coverage && pnpm run build && pnpm run size",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "version-packages": "changeset version",
    "release:tag": "changeset tag",
    "prepare": "husky"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "howler": "2.2.4"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@size-limit/file": "14.3.0",
    "@types/howler": "2.2.13",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "acorn": "8.19.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "size-limit": "14.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
